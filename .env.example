# OPCIONAL. La página funciona sin .env: la base (db/meridian.db) y la SECRET_KEY (.secret_key) se crean solas.
# Copia este archivo como .env solo si quieres cambiar algo. No subas tu .env al repositorio.

# Puerto preferido (si está ocupado se usa el siguiente libre)
PUERTO=8000

# Llave para firmar la cookie de sesión. Vacía = se usa la de .secret_key, generada automáticamente.
SECRET_KEY=
