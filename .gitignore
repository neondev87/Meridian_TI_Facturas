# Archivos que nunca entran al repositorio: datos de la base, secretos, entorno virtual y temporales.
# Del directorio db/ solo se suben esquema.sql y semillas.sql.

# Base de datos SQLite con datos reales (usuarios, facturas) y sus archivos auxiliares
db/meridian.db
db/meridian.db.nueva
db/*.db
db/*.db-wal
db/*.db-shm
db/*.db-journal
*.sqlite
*.sqlite3

# Secretos y configuración local
.secret_key
.env
.env.*
!.env.example
.servidor.pid

# Python
venv/
__pycache__/
*.pyc

# Respaldos y registros
*.bak
respaldos/
*.log

# Editor
.vscode/
*.dump

# PDF pesados o ajenos al sitio (material de la escuela). El PDF de la presentación en docs/ sí se sube.
/*.pdf
original-presentacion.pdf
